# Copie para .env apenas no seu computador/servidor. Nunca publique o .env.
SILED_ENV=local
HOST=127.0.0.1
PORT=5000
# No modo local, uma chave aleatória é gerada em instance/.secret_key.
# Em produção, FLASK_SECRET_KEY é obrigatória, aleatória e com 32+ caracteres.
FLASK_SECRET_KEY=
# Opcional: diretório absoluto do banco e dos anexos. Padrão: instance/
SILED_DATA_DIR=
TRUST_PROXY=0
POWERBI_EMBED_URL=
POWERBI_REPORT_TITLE=Painel Microsoft Power BI
POWERBI_WORKSPACE_NAME=Unidade central
# Apenas primeiro administrador na hospedagem. Use segredos da plataforma.
SILED_ADMIN_CPF=
SILED_ADMIN_NAME=
SILED_ADMIN_PASSWORD=
